  "narrative": {
    "northStar": "Find the evidence quickly.",
    "overview": "The homepage adopts the user-approved Madeo composition: white ground, a large open two-line headline, useful search alongside and staggered visual canvases. Actual result graphics and source-linked research recommendations form the work on display. Compact research routes retain their established practical density, typography and resource cards.\n\nThe home composition is a surface-specific expression, not a replacement for the compact subpage system. Conceptual covers belong only to research news; evaluation graphics remain explicit, accessible representations of the same historical records used by the dashboard.",
    "keyCharacteristics": [
      "Open headline and search above staggered, equal-width home canvases.",
      "Historical charts with names, numbers, settings and source dates.",
      "Compact 3/2/1-column research routes with small icons and team initials.",
      "White ground, flat surfaces and four-language continuity."
    ],
    "rules": [
      {
        "name": "Shared Evidence",
        "body": "Home charts, the results dashboard, numeric tables and CSV derive from shared records; preserve version, setting, date and ×100 disclosure.",
        "section": "components"
      },
      {
        "name": "Surface Scope",
        "body": "Apply the large staggered composition to Home; retain compact resource layouts on other routes.",
        "section": "layout"
      },
      {
        "name": "Flat Surface",
        "body": "Use spacing, fine rules and chart-specific tonal canvases to separate content; do not add card shadows to Home.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve white ground and use the pale chart fills only within their home canvases.",
      "Do keep explicit model names, values, 0–100 axes, historical date and source links beside both home charts.",
      "Do retain compact subpage tokens, horizontal results bars and internally scrolling tables.",
      "Do preserve visible keyboard focus, reduced motion, route state, locale continuity and form drafts."
    ],
    "donts": [
      "Don't restore the rejected compact dashboard composition on Home.",
      "Don't expand the home gallery treatment into resource subpages.",
      "Don't use conceptual covers as paper figures, model evidence or member portraits.",
      "Don't invent current rankings, overall-safety percentages, posts, team work or submission success."
    ]
  },
